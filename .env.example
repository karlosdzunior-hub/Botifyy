TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GROK_API_KEY=your_groq_api_key_here

BOT_USERNAME=your_bot_username_without_at

# ЮMoney — один кошелёк для всех проектов
YOOMONEY_WALLET=410011xxxxxxxxx
YOOMONEY_SECRET=your_yoomoney_notification_secret

# Если у тебя уже есть другой сервис на этом кошельке:
# Botify примет ВСЕ уведомления, и если label не начинается с "botify_"
# — перешлёт запрос на этот URL твоему другому сервису
YOOMONEY_FORWARD_URL=https://your-other-service.com/yoomoney/webhook

# Порт для webhook-сервера (8090 чтобы не конфликтовать)
WEBHOOK_PORT=8090

DB_PATH=/app/botify.db
